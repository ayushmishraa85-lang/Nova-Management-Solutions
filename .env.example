# Copy this file to .env for local development (never commit the real .env — see .gitignore).
#
# DATABASE_URL format:
#   postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
#
# Use a remotely hosted PostgreSQL instance for anything beyond your own
# machine (Supabase, Neon, Render, RDS, etc.) — localhost/127.0.0.1/::1
# will NOT work once deployed to Streamlit Cloud, since the deployed app
# can't reach a database running on your laptop.
#
# For local development only, localhost is fine, e.g.:
# DATABASE_URL=postgresql+psycopg://novams:novams@localhost:5432/novams

DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
